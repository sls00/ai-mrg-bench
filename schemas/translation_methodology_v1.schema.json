{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sls00.github.io/ai-mrg-bench/schemas/translation_methodology_v1.schema.json",
  "title": "Adverse-Action Translation Methodology",
  "type": "object",
  "required": [
    "methodology_id",
    "model_id",
    "model_version",
    "created_utc",
    "purpose_and_scope",
    "attribution_method",
    "feature_inventory",
    "mapping_rules",
    "validation_protocol",
    "change_control",
    "known_limitations"
  ],
  "properties": {
    "methodology_id": {
      "type": "string",
      "const": "translation_methodology_v1"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "minLength": 1
    },
    "purpose_and_scope": {
      "type": "object",
      "required": [
        "models",
        "decision_types",
        "regulatory_anchor",
        "historical_interpretive_context"
      ],
      "properties": {
        "models": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "decision_types": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "regulatory_anchor": { "type": "string", "minLength": 1 },
        "historical_interpretive_context": { "type": "string", "minLength": 1 }
      }
    },
    "attribution_method": {
      "type": "object",
      "required": ["primary", "output_space", "background_dataset", "top_k_principal_reasons"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "output_space": { "type": "string", "minLength": 1 },
        "background_dataset": { "type": "string", "minLength": 1 },
        "approximations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "top_k_principal_reasons": { "type": "integer", "minimum": 1 }
      }
    },
    "feature_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["feature", "business_definition"],
        "properties": {
          "feature": { "type": "string", "minLength": 1 },
          "business_definition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mapping_rules": {
      "type": "object",
      "required": ["rules", "mappings"],
      "properties": {
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "feature",
              "business_definition",
              "factor_description_template",
              "specificity_test"
            ],
            "properties": {
              "feature": { "type": "string" },
              "business_definition": { "type": "string" },
              "factor_description_template": { "type": "string" },
              "specificity_test": { "type": "string", "enum": ["pass", "fail"] }
            }
          }
        }
      }
    },
    "validation_protocol": {
      "type": "object",
      "required": ["fidelity_report_id", "tests"],
      "properties": {
        "fidelity_report_id": { "type": "string", "minLength": 1 },
        "tests": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "change_control": { "type": "string", "minLength": 1 },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
